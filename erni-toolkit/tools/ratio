#!/usr/bin/env python3
"""Band-ratio quick-look: sum(thermal slices) / sum(short-lambda slices).

    ratio STACK [-o OUT.png] [-b BIN] [-p LO HI] [-c CMAP]

Defaults bin 4x4. At ~5 thermal counts per raw pixel the per-pixel Poisson noise
is ~44%, several times the contrast you are looking for, so an unbinned image is
noise. Binning is free here: the LumaCam's spatial resolution is set by the 450 um
scintillator, not the pixel pitch, so pixels finer than that carry no independent
information. -b 1 turns it off.
"""
import argparse, os, numpy as np, tifffile, matplotlib.pyplot as plt

p = argparse.ArgumentParser()
p.add_argument('stack')
p.add_argument('-o', '--out')
p.add_argument('-b', '--bin', type=int, default=4, help='NxN pixel binning (default 4)')
p.add_argument('-p', '--pct', type=float, nargs=2, default=[1, 99], metavar=('LO', 'HI'))
p.add_argument('-c', '--cmap', default='gray')
p.add_argument('-e', '--eq', action='store_true',
               help='histogram-equalise instead of a linear stretch. Use when the '
                    '1/25/50/75/99 row below is bimodal (a big jump between two '
                    'quartiles): a linear ramp spends the colour scale on the gap '
                    'and flattens everything inside each population. The mapping '
                    'is then nonlinear, so grey level no longer means a ratio.')
p.add_argument('--open', dest='ob', metavar='OPENBEAM',
               help='divide by the thermal band of an OPEN-BEAM run instead of by '
                    'this run\'s short-lambda band. This is the right one: it '
                    'cancels beam profile and detector response like the band ratio '
                    'does, but keeps the full sample contrast, because the open beam '
                    'has no sample in it. Needs the same detector geometry.')
p.add_argument('--plain', action='store_true',
               help='skip the division: show the thermal band sum alone. The '
                    'denominator band is not transparent, so dividing cancels part '
                    'of the sample signal along with the beam profile. If the beam '
                    'is reasonably flat, plain wins. Compare the two.')
p.add_argument('--epi', type=int, nargs=2, default=[0, 500], metavar=('A', 'B'))
p.add_argument('--thm', type=int, nargs=2, default=[749, 1500], metavar=('A', 'B'))
p.add_argument('--beam', type=float, default=0.3,
               help='drop pixels whose denominator is below this fraction of the '
                    'median (default 0.3): outside the beam spot a ratio of two '
                    'small numbers is not a measurement, and it sets your colour scale')
a = p.parse_args()

out = a.out or os.path.splitext(a.stack)[0] + '_ratio.png'
rd = lambda f: np.load(f)['data'] if f.endswith('.npz') else tifffile.imread(f)
s = rd(a.stack)
thm = s[a.thm[0]:a.thm[1]].sum(0, dtype=float)
if a.ob:
    o = rd(a.ob)
    if o.shape[1:] != s.shape[1:]:
        raise SystemExit(f'open beam is {o.shape[1:]}, sample is {s.shape[1:]}')
    epi = o[a.thm[0]:a.thm[1]].sum(0, dtype=float)      # SAME band, no sample
else:
    epi = s[a.epi[0]:a.epi[1]].sum(0, dtype=float)

b = a.bin
if b > 1:                                    # sum, not mean: keeps counts Poisson
    h, w = (epi.shape[0]//b)*b, (epi.shape[1]//b)*b
    rs = lambda x: x[:h, :w].reshape(h//b, b, w//b, b).sum((1, 3))
    epi, thm = rs(epi), rs(thm)

beam = epi > a.beam * np.median(epi[epi > 0])
r = np.where(beam, thm, np.nan) if a.plain else \
    np.divide(thm, epi, out=np.full(epi.shape, np.nan), where=beam)
lo, hi = np.percentile(r[beam], a.pct)
if a.eq:                                     # rank-transform: every grey level equally used
    v = np.sort(r[beam])
    disp = np.zeros(r.shape)
    disp[beam] = np.searchsorted(v, r[beam]).astype(float) / max(len(v) - 1, 1)
else:
    disp = np.nan_to_num(np.clip((r - lo) / (hi - lo), 0, 1))
if b > 1:                                    # blow back up so the PNG is viewable
    disp = np.repeat(np.repeat(disp, b, 0), b, 1)
plt.imsave(out, disp, cmap=a.cmap, vmin=0, vmax=1)

q = np.percentile(r[beam], [1, 25, 50, 75, 99])
cts = thm[beam].mean()
mode = 'thermal only' if a.plain else (f'/ open beam {os.path.basename(a.ob)}'
        if a.ob else f'/ own band {a.epi[0]}:{a.epi[1]}')
print(f'{r.shape} after {b}x{b} binning   in beam {100*beam.mean():.0f}%   {mode}')
print(f'thermal counts per bin {cts:,.0f}  -> Poisson noise {100/np.sqrt(max(cts,1)):.1f}%')
print(f'{"thermal" if a.plain else "ratio  "} 1/25/50/75/99 pct  ' + '  '.join(f'{v:.4f}' for v in q))
print(f'stretch {lo:.4f}..{hi:.4f}  ({a.pct[0]:g}-{a.pct[1]:g} pct in beam)  -> {out}')
